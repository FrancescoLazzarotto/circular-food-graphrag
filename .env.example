# Neo4j — the retrieval engine reads NEO4J_URL / NEO4J_USERNAME and nothing
# else. The KG pipeline, the repair passes and the analysis scripts go through
# kg_pipeline/utils/neo4j_env.py, which also accepts NEO4J_URI / NEO4J_USER /
# NEO4J_DB — and prefers NEO4J_URI and NEO4J_USER when both spellings are set.
# So set one spelling per name: a leftover NEO4J_URI silently sends the pipeline
# to a different graph than the one the engine answers from.
NEO4J_URL=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
# Optional; the project database is documented in kg_pipeline/config.yaml.
# Empty means the server's default database.
NEO4J_DATABASE=

# HuggingFace (gated models)
HF_TOKEN=

# vLLM OpenAI-compatible endpoint (used with --vllm and by the LLM judge)
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL_NAME=Qwen/Qwen2.5-32B-Instruct
VLLM_API_KEY=

# Multilingual encoder for the vector retrieval channel. Required whenever
# --vector-retrieval is on, which both demos and the reference campaign use:
# without it the encoder call fails and retrieval raises rather than degrading.
# Served by scripts/serving/start_vllm_encoder.sh.
GRAPHRAG_EMBED_BASE_URL=http://localhost:8002/v1
GRAPHRAG_EMBED_MODEL=intfloat/multilingual-e5-base
# Interactive use only: lets a query fall back to lexical-only when the encoder
# is unreachable, because a lexical answer beats no answer at a live demo.
# Leave it unset for measurements — a silent fallback makes runs incomparable.
# GRAPHRAG_VECTOR_ALLOW_DEGRADED=1

# Optional tuning (defaults shown)
# GRAPHRAG_NEO4J_QUERY_RETRIES=3
# GRAPHRAG_NEO4J_QUERY_RETRY_BACKOFF_SEC=1.0
# GRAPHRAG_LLM_GENERATE_RETRIES=2
# GRAPHRAG_LLM_GENERATE_RETRY_BACKOFF_SEC=1.0
# GRAPHRAG_VLLM_HEALTHCHECK_TIMEOUT_SEC=5
# GRAPHRAG_OFFLOAD_DIR=/tmp/graphrag-offload
# EVAL_NORMALIZE_REMOVE_ACCENTS=1
