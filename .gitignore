# Python cache and bytecode
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Build artifacts
build/
dist/
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# IDE and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Secrets and local env files
.env
.env.*
!.env.example

# Test and coverage
.pytest_cache/
.coverage
htmlcov/

# Cluster logs
logs/
.log

# Local experiment outputs
artifacts/
exp_results*/
lib/
documents/

# Scratch files a run drops in the repository root. Anchored with a leading
# slash, because unanchored these match at any depth and did: `kg_evaluator.py`
# also matched scripts/analysis/kg_evaluator.py, and three fixtures under
# evaluation/fixtures/ were silently left out of the repository, one of them the
# default --questions-file of scripts/runners/run_ab_fast_profile.py.
/questions.txt
/questions_matrix_long.txt
/questions_test_strategies.txt
/dry_run.log
/kg_evaluator.py
/kg_evaluator_run.log
/output.txt
/pipeline.log
/pipeline.out
/ruff_output.txt
/test_experiment.log

# Gold protocol / raw hand-off (kept local)
gold_entity_eval_protocol.md
gold_original_from_collega_20260716.json

# Internal development docs (plans, audits, worklogs, probes): working notes,
# not part of the shipped codebase. Kept local on purpose.
docs/*_plan*.md
docs/*audit*.md
docs/*worklog*.md
docs/*probe*.md
docs/iswc_paper_gap_analysis.md

# Paper/thesis LaTeX sources live outside the code repository.
docs/report_latex/

# Agent/editor scaffolding
.github/prompts/

# Scratch scripts: leading underscore marks a throwaway with hardcoded paths.
scripts/_*.py
scripts/**/_*.py
